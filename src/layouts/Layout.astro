---
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header class="container site-header">
      <a href="/" class="logo">Delfitra</a>
      <nav>
        <a href="/">Home</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      © 2026 Professor Croquette
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
  }

  .logo {
    font-weight: 700;
    color: white;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: white;
  }

  .site-footer {
    padding: 3rem 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
