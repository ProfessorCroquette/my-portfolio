---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Name | Portfolio">
  <section class="hero">
    <p class="eyebrow">Hi, I'm</p>
    <h1>Delfitra A.S</h1>
    <p class="intro">
      Programmer, Graphic designer, and Your professional croquette enjoyer.
    </p>
    <div class="actions">
      <a href="/projects" class="btn btn-primary">View my work</a>
      <a href="mailto:you@email.com" class="btn btn-secondary">Contact me</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 25rem;
    height: 25rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(79, 70, 229, 0.35) 0%, rgba(79, 70, 229, 0) 70%);
    pointer-events: none;
    z-index: -1;
  }

  .eyebrow {
    color: var(--color-indigo-light);
    font-weight: 500;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    color: white;
    margin-top: 0.5rem;
  }

  .intro {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn {
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--color-indigo);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-indigo-light);
  }

  .btn-secondary {
    border: 1px solid var(--color-cobalt);
    color: var(--color-cobalt);
  }

  .btn-secondary:hover {
    background: var(--color-cobalt);
    color: white;
  }
</style>
